[Unit]
Description=Stock Predictor Web Application
After=network.target
Documentation=https://github.com/NoMadAndy/stockPredictor

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/stockpredictor
Environment="PATH=/opt/stockpredictor/venv/bin"
Environment="PORT=8001"
Environment="SECRET_KEY=change_this_in_production"
Environment="DEBUG=false"
ExecStart=/opt/stockpredictor/venv/bin/python app.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/stockpredictor.log
StandardError=append:/var/log/stockpredictor-error.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stockpredictor

[Install]
WantedBy=multi-user.target
